<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cardápio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <h1 class="text-center mb-5">Nosso Cardápio</h1>

    <div class="row">

        {% for produto in produtos %}

        <div class="col-md-3">

            <div class="card shadow mb-4">

                <img
                    src="{{ url_for('static', filename='imagens/' + produto.imagem) }}"
                    class="card-img-top"
                    height="200"
                >

                <div class="card-body">

                    <h5>{{ produto.nome }}</h5>

                    <p>{{ produto.descricao }}</p>

                    <h6>{{ produto.preco }}</h6>

                    <a href="/lanche/{{ produto.nome.lower() }}"
                       class="btn btn-primary">

                        Comprar

                    </a>

                </div>

            </div>

        </div>

        {% endfor %}

    </div>

</div>

</body>
</html>
