<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodExpress</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

        <a class="navbar-brand" href="/">FoodExpress</a>

        <div>
            <a class="btn btn-outline-light" href="/">Home</a>
            <a class="btn btn-outline-light" href="/cardapio">Cardápio</a>
            <a class="btn btn-outline-light" href="/pedidos">Pedidos</a>
            <a class="btn btn-outline-light" href="/contato">Contato</a>
        </div>

    </div>
</nav>

<div class="container mt-4">

    <div class="alert alert-success text-center">
        Frete grátis acima de R$ 50!
    </div>

    <div id="carouselExample" class="carousel slide mb-5">

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="{{ url_for('static', filename='imagens/banner1.jpg') }}"
                     class="d-block w-100">
            </div>

            <div class="carousel-item">
                <img src="{{ url_for('static', filename='imagens/banner2.jpg') }}"
                     class="d-block w-100">
            </div>

            <div class="carousel-item">
                <img src="{{ url_for('static', filename='imagens/banner3.jpg') }}"
                     class="d-block w-100">
            </div>

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#carouselExample"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>

        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#carouselExample"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>

        </button>

    </div>

    <div class="text-center">

        <h1>FoodExpress</h1>

        <p class="lead">
            O melhor delivery da cidade!
        </p>

        <a href="/cardapio" class="btn btn-danger btn-lg">
            Ver Cardápio
        </a>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
